# pi-card configuration.
# Copy this file to ~/.config/pi-card/config.yaml (or pass --config), then fill in
# the three required agent fields. All other values have sensible defaults.

agent:
  # OpenAI-compatible chat-completions endpoint.
  base_url: https://api.openai.com/v1
  api_key: REPLACE_WITH_YOUR_API_KEY
  # Prefer a non-reasoning model for low voice-latency (see Project_Overview.md).
  model: gpt-4o-mini

# Optional overrides (defaults shown):
# language: en               # starting language; "en" or "fr". Switchable mid-session.
# silence_timeout: 5.0       # seconds of silence before returning to wake-word mode.
# min_silence_duration_ms: 2500  # ms a mid-utterance pause may last before the turn ends.
#                                # Increase if the device cuts you off during natural pauses.
# max_stt_retries: 2         # low-confidence STT retries before giving up.
# wake_word: computer        # one of: computer, alexa, hey_jarvis, hey_mycroft, hey_rhasspy.
# wake_word_threshold: 0.5   # detection score required to trigger; range (0.0, 1.0].
#                            # Raise (e.g. 0.6–0.7) to cut false positives on `computer`,
#                            # at the cost of needing a clearer enunciation.

# Speech-to-text. Defaults to local Faster-Whisper (offline). Switch to Aqueduct's
# whisper-large-v3-turbo for ~19x faster transcription when an on-prem gateway is
# available — privacy holds (audio stays inside the organisational boundary):
# stt:
#   provider: aqueduct        # one of: local, aqueduct
#   model: whisper-large-v3-turbo

# Provider-specific request body extensions, forwarded verbatim to the chat-completions
# endpoint. Use this when the model needs a knob the standard schema doesn't expose —
# e.g. disabling Qwen3's "thinking" mode for low voice latency:
# extra_body:
#   chat_template_kwargs:
#     enable_thinking: false
